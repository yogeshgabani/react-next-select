{
  "name": "react-next-select",
  "version": "0.5.0",
  "description": "Accessible, SSR-safe React Select for Next.js — single/multi, async, grouped options, one-prop color themes, zero dependencies",
  "author": "Yogesh Gabani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogeshgabani/react-next-select.git"
  },
  "homepage": "https://github.com/yogeshgabani/react-next-select#readme",
  "bugs": {
    "url": "https://github.com/yogeshgabani/react-next-select/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && node -e \"require('fs').copyFileSync('src/index.d.ts','dist/index.d.ts')\"",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "react",
    "select",
    "react-select",
    "nextjs",
    "next.js",
    "ssr",
    "combobox",
    "dropdown",
    "multiselect",
    "multi-select",
    "async-select",
    "searchable",
    "accessible",
    "a11y",
    "react-component",
    "form",
    "form-input",
    "custom-select",
    "single-select",
    "select-dropdown",
    "select-input",
    "ui-component",
    "app-router",
    "typescript",
    "react-select-alternative",
    "nextjs-select",
    "autocomplete",
    "grouped-options",
    "option-groups",
    "themeable",
    "dark-mode",
    "creatable",
    "tags-input"
  ],
  "engines": {
    "node": ">=16"
  }
}
